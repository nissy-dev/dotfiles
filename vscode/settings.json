{
  "workbench.startupEditor": "none", // Welcome Page を表示しない
  "workbench.iconTheme": "material-icon-theme",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue", // 拡張機能のサジェストで上書きする
  /* editor setting */
  "editor.formatOnSave": true, // ファイル保存時にフォーマット
  "editor.fontFamily": "'HackGen35Nerd Console', Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.minimap.enabled": false, // ミニマップを非表示
  "editor.renderWhitespace": "all", // ホワイトスペース（半角スペース等）の表示
  "editor.renderControlCharacters": true, // 制御文字表示
  "editor.suggestSelection": "first", // サジェストの表示方法
  "editor.tabSize": 2,
  /* files setting */
  "files.trimTrailingWhitespace": true, // 余分なホワイトスペースを削除
  "files.insertFinalNewline": true, // ファイルの末尾は改行で終わらせる
  "files.trimFinalNewlines": true, // 保存時に最終行以降を削除
  "files.associations": {
    ".*lintrc": "json",
    "*.flow": "javascript"
  },
  /* markdown setting */
  "[markdown]": {
    "editor.formatOnSave": false,
    "files.trimTrailingWhitespace": false // Markdownのファイルは行末の空白をトリミングしない
  },
  /* json setting */
  "[json]": {
    "editor.tabSize": 4
  },
  /* javascript setting */
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode", // フォーマッタをprettierに指定
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  /* typescript setting */
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.stylelint": "explicit"
    }
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.stylelint": "explicit"
    }
  },
  "typescript.locale": "en", // エラーメッセージを英語にする
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.updateImportsOnFileMove.enabled": "always",
  /* python setting */
  "[python]": {
    "editor.tabSize": 4,
    "editor.formatOnType": true
  },
  "python.linting.pylintEnabled": false,
  "python.linting.flake8Enabled": true,
  "python.linting.flake8Args": ["--ignore=E501,W503"],
  "python.formatting.provider": "black",
  "python.languageServer": "Default",
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook"
  },
  /* go setting */
  "[go]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  /* GitHub Copilot */
  "editor.inlineSuggest.enabled": true,
  "github.copilot.editor.enableAutoCompletions": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "chat.notifyWindowOnResponseReceived": "always",
  "chat.notifyWindowOnConfirmation": "always",
  "chat.tools.terminal.autoApprove": {
    "git": true,
    "/^git (push|reset|clean)(\\s|$)/": false,
    "/^gh browse(\\s|$)/": true,
    "/^gh issue (list|status|view)(\\s|$)/": true,
    "/^gh pr (checks|diff|list|status|view)(\\s|$)/": true,
    "/^gh search (commits|issues|prs|repos)(\\s|$)/": true,
    "/^gh run (list|view|watch)(\\s|$)/": true,
    "/^gh workflow (list|view)(\\s|$)/": true,
    "/^gh release (list|view)(\\s|$)/": true,
    "pnpm": true,
    "/^pnpm (install|i|add|dlx|exec)(\\s|$)/": false,
    "make": true,
    "docker": true,
    "rg": true,
    "grep": true,
    "sort": true,
    "uniq": true,
    "cut": true,
    "diff": true,
    "ls": true,
    "pwd": true,
    "cat": true,
    "head": true,
    "tail": true,
    "wc": true,
    "jq": true,
    "ps": true,
    "lsof": true,
    "netstat": true,
    "/^(rm|sudo)(\\s|$)/": false
  },
  "chat.tools.urls.autoApprove": {
    "https://github.com/*": true,
    "https://docs.github.com/*": true,
    "https://developer.mozilla.org/*": true,
    "https://web.dev/*": true,
    "https://zenn.dev/*": true,
    "https://go.dev/*": true,
    "https://pkg.go.dev/*": true,
    "https://rust-lang.org/*": true,
    "https://doc.rust-lang.org/*": true,
    "https://docs.rs/*": true,
    "https://crates.io/*": true,
    "https://nodejs.org/*": true,
    "https://npmjs.com/*": true,
    "https://*.npmjs.com/*": true,
    "https://typescriptlang.org/*": true,
    "https://react.dev/*": true,
    "https://vite.dev/*": true,
    "https://vitest.dev/*": true,
    "https://kubernetes.io/*": true,
    "https://opentelemetry.io/*": true,
    "https://grafana.com/*": true
  },
  /* Ignore files related to Java */
  "files.exclude": {
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true
  },
  "window.zoomLevel": 1,
  "search.followSymlinks": false,
  "claudeCode.preferredLocation": "panel",
  "workbench.editor.empty.hint": "hidden"
}
